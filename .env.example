# Never commit a real credential. Cloud deployment requires a TLS Redis endpoint.
REDIS_URL=
REDIS_PREFIX=watch-party:v1
# Optional exact upstream host allow-list. Empty means no server-side media relay.
MEDIA_ALLOWED_HOSTS=
# Only use these flags for an owner's trusted, loopback-only local setup.
ALLOW_PRIVATE_MEDIA=false
ENABLE_LOCAL_SUBTITLES=false
